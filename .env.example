# ─────────────────────────────────────────────────────────────
# CHRONOS — variáveis de ambiente
# Copie para .env.local (nunca versionado) e preencha.
# Sem NEXT_PUBLIC_SUPABASE_* o app roda em modo demo (localStorage).
# ─────────────────────────────────────────────────────────────

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente no servidor (rotas /api). Nunca exponha com prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do app (links de convite)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PRODUCTNAME=CHRONOS

# Segredos de rotas internas
# CRON_SECRET: /api/cron/due-soon e Edge Functions (também em `supabase secrets set`)
CRON_SECRET=
# ADMIN_SECRET: /api/admin/* (fora do modo development)
ADMIN_SECRET=

# E-mail (Brevo)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=CHRONOS

# Telegram (rota /api/telegram/test)
TELEGRAM_BOT_TOKEN=
